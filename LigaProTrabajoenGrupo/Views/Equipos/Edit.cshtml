@model LigaProTrabajoenGrupo.Models.Equipo

@{
    ViewData["Title"] = "Editar Equipo";
}

<h1>@ViewData["Title"]</h1>

<h4>Equipo</h4>
<hr />
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Campo oculto para el ID del equipo -->
    <input type="hidden" asp-for="EquipoId" />

    <!-- Campo para editar el nombre del equipo -->
    <div class="form-group">
        <label for="Nombre">Nombre</label>
        <input type="text" class="form-control" asp-for="Nombre" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <!-- Campo para editar la descripción del equipo -->
    <div class="form-group">
        <label for="Descripcion">Descripción</label>
        <textarea class="form-control" asp-for="Descripcion" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <!-- Campo para subir el logo (opcional) -->
    <div class="form-group">
        <label for="Logo">Logo</label>
        <input type="file" class="form-control" asp-for="Logo" />
        <span asp-validation-for="Logo" class="text-danger"></span>
    </div>

    <!-- Campo para editar el presupuesto del equipo -->
    <div class="form-group">
        <label for="Presupuesto">Presupuesto</label>
        <input type="number" class="form-control" asp-for="Presupuesto" />
        <span asp-validation-for="Presupuesto" class="text-danger"></span>
    </div>

    <!-- Campo para editar partidos jugados -->
    <div class="form-group">
        <label for="PartidosJugados">Partidos Jugados</label>
        <input type="number" class="form-control" asp-for="PartidosJugados" />
        <span asp-validation-for="PartidosJugados" class="text-danger"></span>
    </div>

    <!-- Campo para editar partidos ganados -->
    <div class="form-group">
        <label for="PartidosGanados">Partidos Ganados</label>
        <input type="number" class="form-control" asp-for="PartidosGanados" />
        <span asp-validation-for="PartidosGanados" class="text-danger"></span>
    </div>

    <!-- Campo para editar partidos empatados -->
    <div class="form-group">
        <label for="PartidosEmpatados">Partidos Empatados</label>
        <input type="number" class="form-control" asp-for="PartidosEmpatados" />
        <span asp-validation-for="PartidosEmpatados" class="text-danger"></span>
    </div>

    <!-- Campo para editar partidos perdidos -->
    <div class="form-group">
        <label for="PartidosPerdidos">Partidos Perdidos</label>
        <input type="number" class="form-control" asp-for="PartidosPerdidos" />
        <span asp-validation-for="PartidosPerdidos" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
</form>

<a asp-action="Index">Volver a la lista</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



