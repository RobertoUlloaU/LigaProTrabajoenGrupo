@model LigaProTrabajoenGrupo.Models.Equipo

@{
    ViewData["Title"] = "Detalles del Equipo";
}

<h1>Detalles del Equipo</h1>

<div>
    <h4>@Model.Nombre</h4>
    <hr />
    <table class="table">
        <tbody>
            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.Nombre)</strong></td>
                <td class="text-end" style="padding-left: 40px;">@Html.DisplayFor(model => model.Nombre)</td> <!-- Alineación a la derecha con espaciado -->
            </tr>

            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.Descripcion)</strong></td>
                <td class="text-end" style="padding-left: 40px;">@Html.DisplayFor(model => model.Descripcion)</td> <!-- Alineación a la derecha con espaciado -->
            </tr>

            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.Logo)</strong></td>
                <td style="padding-left: 40px;">@Html.DisplayFor(model => model.Logo)</td>
            </tr>

            <!-- Alineación con más espacio entre el nombre y el número para el Presupuesto -->
            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.Presupuesto)</strong></td>
                <td class="text-end" style="padding-left: 40px; padding-right: 50px;">@Html.DisplayFor(model => model.Presupuesto)</td> <!-- Alineación a la derecha con más espaciado -->
            </tr>

            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.PartidosJugados)</strong></td>
                <td class="text-end" style="padding-left: 40px; padding-right: 40px;">@Html.DisplayFor(model => model.PartidosJugados)</td> <!-- Alineación a la derecha con espaciado -->
            </tr>

            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.PartidosGanados)</strong></td>
                <td class="text-end" style="padding-left: 40px; padding-right: 40px;">@Html.DisplayFor(model => model.PartidosGanados)</td> <!-- Alineación a la derecha con espaciado -->
            </tr>

            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.PartidosEmpatados)</strong></td>
                <td class="text-end" style="padding-left: 40px; padding-right: 40px;">@Html.DisplayFor(model => model.PartidosEmpatados)</td> <!-- Alineación a la derecha con espaciado -->
            </tr>

            <tr>
                <td style="width: 40%;"><strong>@Html.DisplayNameFor(model => model.PartidosPerdidos)</strong></td>
                <td class="text-end" style="padding-left: 40px; padding-right: 40px;">@Html.DisplayFor(model => model.PartidosPerdidos)</td> <!-- Alineación a la derecha con espaciado -->
            </tr>
        </tbody>
    </table>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.EquipoId">Editar</a> |
    <a asp-action="Index">Volver a la Lista</a>
</div>





